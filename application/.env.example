# PostgreSQL connection strings (Local Docker Compose or Neon Cloud via Vercel Marketplace)
# For Neon: use the pooled "-pooler" URL for DATABASE_URL, and the non-pooled URL for DIRECT_URL
DATABASE_URL="postgresql://vault:vaultpassword@localhost:5432/vault_tracking?schema=public"
DIRECT_URL="postgresql://vault:vaultpassword@localhost:5432/vault_tracking?schema=public"

# Authentication secret (MUST be at least 32 characters in production)
JWT_SECRET="replace_with_a_strong_secret_at_least_32_characters_long"

# Structured server log level: debug | info | warn | error
LOG_LEVEL="info"

# Optional seed credentials for initial ADMIN account
SEED_ADMIN_USERNAME="isa"
SEED_ADMIN_PASSWORD="admin123"
